{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "demo": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "GPT_LIVE_MODEL",
        "ATTENDRA_BACKEND_MODEL",
        "ATTENDRA_TTS_MODEL",
        "BROWSER_CALL_MAX_SECONDS",
        "VOICE_PORT",
        "ATTENDRA_TEST_CALLS",
        "ATTENDRA_SIMULATED_CALLS",
        "ATTENDRA_WEBHOOKS_ALLOW_LOCAL",
        "ATTENDRA_SUMMARY_MODEL",
        "API_PORT",
        "PUBLIC_URL",
        "LOG_LEVEL",
        "ATTENDRA_ACCOUNT_LINKS",
        "ATTENDRA_MCP_URL",
        "ATTENDRA_PROVISIONING_TOKEN",
        "ATTENDRA_ACCOUNT_URL",
        "ATTENDRA_MAIL_HOOK_URL",
        "ATTENDRA_IDLE_MINUTES"
      ]
    }
  }
}
