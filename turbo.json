{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "demo": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "OPENAI_API_KEY",
        "GPT_LIVE_MODEL",
        "ATTENDRA_BACKEND_MODEL",
        "BROWSER_CALL_MAX_SECONDS",
        "VOICE_PORT",
        "ATTENDRA_TEST_CALLS"
      ]
    }
  }
}
