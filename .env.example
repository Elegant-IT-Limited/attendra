# Copy to .env. Never commit the real file.

# Postgres 16. docker compose sets this for you.
DATABASE_URL=postgres://attendra:attendra@localhost:5432/attendra

# 32 random bytes, base64, used to encrypt PHI columns: openssl rand -base64 32
# Losing it makes stored patient data unreadable; keep it in your secret manager.
ATTENDRA_DATA_KEY=

# OpenAI project key. Enough on its own for test calls from the dashboard.
OPENAI_API_KEY=
# Phone calls: GPT-Live SIP enabled on the project, and a webhook subscribed to
# live.transport.incoming. Its signing secret starts with whsec_. Leave empty for no phone calls.
OPENAI_WEBHOOK_SECRET=
GPT_LIVE_MODEL=gpt-live-1
ATTENDRA_BACKEND_MODEL=gpt-6-luna

# The worker (apps/worker) summarises every call after it ends. With OPENAI_API_KEY
# it uses this model, with store off, a 30 second timeout and at most 500 output
# tokens; without a key it writes the summary from the call's facts alone.
ATTENDRA_SUMMARY_MODEL=gpt-6-luna
# The clinic's documents are embedded with this model by the worker, and questions by
# the voice service and the API: set the same value for all three. Without
# OPENAI_API_KEY they all use local embeddings instead.
ATTENDRA_EMBEDDING_MODEL=text-embedding-3-small
# Quality: the model that scores live evals (pnpm eval --live --judge) and the one that
# plays the caller in simulations (pnpm sim). Both cost credit and are never run by CI.
ATTENDRA_JUDGE_MODEL=gpt-6-luna
ATTENDRA_SIM_MODEL=gpt-6-luna
# MCP for other AI agents (apps/mcp, docs/mcp.md). The HTTP server listens here. The
# stdio bridge, started by a desktop MCP client, is set in that client's own config
# with ATTENDRA_MCP_URL and ATTENDRA_API_KEY, and needs nothing from this file.
MCP_PORT=8082
# Records Twilio delivery statuses for texts. Not wired yet: nothing sends the worker
# these jobs until Twilio's status callback is connected, so leave it off.
ATTENDRA_SMS_STATUS=off

# Twilio account that owns the clinic numbers and the Elastic SIP Trunk, and sends
# confirmation texts. Leave both empty and texts are recorded as not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Test calls from the dashboard: the API reaches the voice service with this shared
# token, 32 characters or more: openssl rand -base64 32. Set it for both services.
# With docker compose's voice profile, VOICE_URL=http://voice:8080.
VOICE_INTERNAL_TOKEN=
VOICE_URL=
# A test call ends on its own after this many seconds.
BROWSER_CALL_MAX_SECONDS=300

# The voice service's own port (apps/voice); the API and MCP have API_PORT and MCP_PORT.
PORT=8080
LOG_LEVEL=info

# Dashboard API (apps/api) and dashboard (apps/web).
# At least 32 random characters, used to sign sessions and encrypt two-factor secrets: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address people open in the browser; the only origin allowed to make changes.
PUBLIC_URL=http://localhost:3000
API_PORT=8081
# Where the dashboard forwards /api (read when the dashboard is built).
API_URL=http://127.0.0.1:8081
# true when the API is reached only through the dashboard's proxy (compose sets it), so
# rate limits see each browser's address. The API then trusts exactly that one hop.
TRUST_PROXY=false
# true turns off the two-factor requirement and lets the seed load demo calls and logins.
# Never true on a deployment with real patient data.
ATTENDRA_DEMO_MODE=false
# The demo logins' password, 12 characters or more. Needed only in demo mode.
ATTENDRA_DEMO_PASSWORD=

# `pnpm demo` only. The demo reads its voice settings from this file and these from the
# shell (ATTENDRA_SIMULATED_CALLS=off pnpm demo), and a deployment ignores them:
#   ATTENDRA_TEST_CALLS=off            browser test calls off even with OPENAI_API_KEY set (the e2e suite uses it)
#   ATTENDRA_SIMULATED_CALLS=off       no Play a simulated call on the Test call page (on by default)
#   VOICE_PORT=8080                    the port of the voice service the demo starts in-process
#   ATTENDRA_WEBHOOKS_ALLOW_LOCAL=on   lets webhooks go to 127.0.0.1, for a receiver on this machine
