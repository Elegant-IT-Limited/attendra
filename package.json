{
  "name": "attendra",
  "private": true,
  "description": "Open-source AI phone receptionist for medical practices: Twilio SIP, OpenAI GPT-Live, and a TypeScript backend that owns identity, scheduling and audit.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @attendra/evals run eval",
    "sim": "pnpm --filter @attendra/evals run sim",
    "db:migrate": "pnpm --filter @attendra/db run migrate",
    "db:seed": "pnpm --filter @attendra/db run seed",
    "db:add-number": "pnpm --filter @attendra/db run add-number",
    "db:rehash-lookups": "pnpm --filter @attendra/db run rehash-lookups",
    "add-member": "pnpm --filter @attendra/api add-member",
    "demo": "turbo run demo",
    "test:e2e": "pnpm --filter @attendra/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
